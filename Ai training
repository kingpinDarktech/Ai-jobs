<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Trainer Hub — Remote AI Training Jobs</title>
  <meta name="description" content="Apply for remote AI training jobs. Work from anywhere, get paid in USD." />
  <style>
    /* ---------- DESIGN TOKENS ---------- */
    :root {
      --bg: #0b0e14;
      --surface: #131720;
      --surface-2: #1a1f2b;
      --border: #252b3a;
      --text: #e8ecf4;
      --muted: #8b95a8;
      --accent: #5b8cff;
      --accent-2: #7c5cff;
      --success: #34d399;
      --radius: 16px;
      --radius-sm: 10px;
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
      --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    /* ---------- RESET ---------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    img { max-width: 100%; display: block; }
    button { font-family: inherit; cursor: pointer; border: none; }

    /* ---------- UTILITY ---------- */
    .container { width: min(1120px, 92%); margin-inline: auto; }
    .section { padding: 88px 0; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--accent);
      background: rgba(91, 140, 255, 0.1);
      padding: 6px 14px; border-radius: 999px; margin-bottom: 18px;
    }
    .section-title {
      font-size: clamp(1.6rem, 3.2vw, 2.4rem);
      font-weight: 800; letter-spacing: -0.02em; line-height: 1.2;
      margin-bottom: 12px;
    }
    .section-sub { color: var(--muted); font-size: 1.05rem; max-width: 560px; margin-bottom: 40px; }

    /* ---------- HEADER ---------- */
    header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(11, 14, 20, 0.85);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }
    .nav {
      display: flex; align-items: center; justify-content: space-between;
      height: 68px;
    }
    .logo {
      display: flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 1.15rem; letter-spacing: -0.02em;
      color: var(--text);
    }
    .logo-mark {
      width: 34px; height: 34px; border-radius: 9px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      display: grid; place-items: center; font-size: 1rem; color: #fff;
    }
    .nav-links { display: flex; gap: 28px; align-items: center; }
    .nav-links a { color: var(--muted); font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
    .nav-links a:hover { color: var(--text); }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 11px 22px; border-radius: var(--radius-sm);
      font-size: 0.9rem; font-weight: 600; transition: all 0.2s;
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff;
      box-shadow: 0 4px 20px rgba(91, 140, 255, 0.35);
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 26px rgba(91, 140, 255, 0.5); }
    .btn-ghost {
      background: transparent; color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { background: var(--surface-2); border-color: var(--accent); }
    .btn-full { width: 100%; }

    /* ---------- HERO ---------- */
    .hero { padding: 100px 0 60px; position: relative; overflow: hidden; }
    .hero::before {
      content: ''; position: absolute; top: -160px; left: 50%; transform: translateX(-50%);
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(91, 140, 255, 0.12), transparent 65%);
      pointer-events: none;
    }
    .hero-inner { position: relative; text-align: center; max-width: 780px; margin-inline: auto; }
    .hero h1 {
      font-size: clamp(2.2rem, 5.2vw, 3.8rem);
      font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
      margin-bottom: 20px;
    }
    .hero h1 .grad {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .hero p { color: var(--muted); font-size: 1.12rem; max-width: 600px; margin: 0 auto 36px; }
    .hero-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-bottom: 56px; }
    .stats {
      display: flex; gap: 40px; justify-content: center; flex-wrap: wrap;
      padding: 28px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    }
    .stat { text-align: center; }
    .stat-val { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; }
    .stat-val .grad { background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .stat-label { color: var(--muted); font-size: 0.85rem; margin-top: 2px; }

    /* ---------- JOB LISTINGS ---------- */
    .jobs-grid { display: grid; gap: 16px; }
    .job-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 24px;
      display: grid; grid-template-columns: 1fr auto; gap: 20px;
      transition: all 0.22s;
    }
    .job-card:hover {
      border-color: rgba(91, 140, 255, 0.4);
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
    .job-main { display: flex; flex-direction: column; gap: 8px; }
    .job-top { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .job-role { font-size: 1.12rem; font-weight: 700; letter-spacing: -0.01em; }
    .job-badge {
      font-size: 0.7rem; font-weight: 600; padding: 3px 10px; border-radius: 999px;
      background: rgba(91, 140, 255, 0.12); color: var(--accent);
    }
    .job-badge.hot { background: rgba(52, 211, 153, 0.12); color: var(--success); }
    .job-meta { display: flex; gap: 18px; flex-wrap: wrap; color: var(--muted); font-size: 0.85rem; }
    .job-meta span { display: inline-flex; align-items: center; gap: 5px; }
    .job-desc { color: var(--muted); font-size: 0.9rem; max-width: 620px; }
    .job-side { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 10px; min-width: 140px; }
    .job-pay { font-size: 1.25rem; font-weight: 800; color: var(--success); white-space: nowrap; }
    .job-pay small { font-size: 0.7rem; font-weight: 500; color: var(--muted); }
    .btn-apply {
      background: var(--surface-2); color: var(--text);
      border: 1px solid var(--border); font-size: 0.82rem; padding: 9px 18px;
      border-radius: var(--radius-sm); font-weight: 600; transition: all 0.2s;
    }
    .btn-apply:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

    /* ---------- HOW IT WORKS ---------- */
    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .step {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 28px;
    }
    .step-num {
      width: 38px; height: 38px; border-radius: 10px;
      background: rgba(91, 140, 255, 0.12); color: var(--accent);
      display: grid; place-items: center; font-weight: 800; font-size: 1rem;
      margin-bottom: 16px;
    }
    .step h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
    .step p { color: var(--muted); font-size: 0.88rem; }

    /* ---------- APPLY FORM ---------- */
    .apply-section { background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .apply-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
    .apply-info h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin-bottom: 16px; letter-spacing: -0.02em; }
    .apply-info p { color: var(--muted); margin-bottom: 28px; max-width: 460px; }
    .fee-box {
      background: var(--bg); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 24px;
    }
    .fee-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
    .fee-row:last-child { border-bottom: none; }
    .fee-row.total { font-weight: 800; font-size: 1.1rem; }
    .fee-row .price { color: var(--success); font-weight: 700; }
    .fee-note { color: var(--muted); font-size: 0.78rem; margin-top: 12px; }

    .form-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 32px;
    }
    .form-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; }
    .form-card .sub { color: var(--muted); font-size: 0.85rem; margin-bottom: 24px; }
    .field { margin-bottom: 18px; }
    .field label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--text); }
    .field input, .field select {
      width: 100%; padding: 12px 14px; font-size: 0.92rem;
      background: var(--bg); border: 1px solid var(--border);
      border-radius: var(--radius-sm); color: var(--text);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .field input:focus, .field select:focus {
      outline: none; border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(91, 140, 255, 0.15);
    }
    .field input::placeholder { color: #5a6478; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-disclaimer { color: var(--muted); font-size: 0.75rem; margin-top: 14px; text-align: center; }
    .form-msg { padding: 12px; border-radius: var(--radius-sm); font-size: 0.85rem; margin-top: 14px; display: none; }
    .form-msg.error { background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); display: block; }
    .form-msg.success { background: rgba(52, 211, 153, 0.1); color: var(--success); border: 1px solid rgba(52, 211, 153, 0.2); display: block; }

    /* ---------- FOOTER ---------- */
    footer { padding: 48px 0; border-top: 1px solid var(--border); }
    .footer-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
    .footer-inner p { color: var(--muted); font-size: 0.82rem; }
    .footer-links { display: flex; gap: 24px; }
    .footer-links a { color: var(--muted); font-size: 0.82rem; }
    .footer-links a:hover { color: var(--text); }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 820px) {
      .apply-grid { grid-template-columns: 1fr; gap: 36px; }
      .job-card { grid-template-columns: 1fr; }
      .job-side { flex-direction: row; align-items: center; justify-content: space-between; }
      .nav-links { display: none; }
      .hero { padding: 70px 0 40px; }
      .section { padding: 64px 0; }
    }
    @media (max-width: 560px) {
      .field-row { grid-template-columns: 1fr; }
      .stats { gap: 24px; }
      .stat-val { font-size: 1.4rem; }
    }

    /* ---------- TOAST ---------- */
    .toast {
      position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(20px);
      background: var(--success); color: #042f1e; font-weight: 700; font-size: 0.88rem;
      padding: 14px 28px; border-radius: 999px; box-shadow: var(--shadow);
      opacity: 0; transition: all 0.35s; z-index: 200; pointer-events: none;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

  <!-- ========== HEADER ========== -->
  <header>
    <div class="container nav">
      <a href="#" class="logo">
        <span class="logo-mark">AI</span> Trainer Hub
      </a>
      <nav class="nav-links">
        <a href="#jobs">Jobs</a>
        <a href="#how">How it works</a>
        <a href="#apply">Apply</a>
      </nav>
      <a href="#apply" class="btn btn-primary">Apply now</a>
    </div>
  </header>

  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">● Remote · USD pay · Flexible hours</span>
      <h1>Train the next generation of <span class="grad">AI models</span> from anywhere.</h1>
      <p>Real remote AI training jobs. Work on your schedule, get paid in US dollars, and help shape the future of AI. One simple $15 application fee.</p>
      <div class="hero-actions">
        <a href="#jobs" class="btn btn-primary">Browse jobs</a>
        <a href="#how" class="btn btn-ghost">How it works</a>
      </div>
      <div class="stats">
        <div class="stat"><div class="stat-val"><span class="grad">3,400+</span></div><div class="stat-label">Open roles</div></div>
        <div class="stat"><div class="stat-val"><span class="grad">$15–$80</span></div><div class="stat-label">Hourly pay range</div></div>
        <div class="stat"><div class="stat-val"><span class="grad">100%</span></div><div class="stat-label">Remote</div></div>
        <div class="stat"><div class="stat-val"><span class="grad">$15</span></div><div class="stat-label">One-time fee</div></div>
      </div>
    </div>
  </section>

  <!-- ========== JOB LISTINGS ========== -->
  <section class="section" id="jobs">
    <div class="container">
      <span class="eyebrow">Live opportunities</span>
      <h2 class="section-title">Remote AI training jobs</h2>
      <p class="section-sub">Realistic roles from real AI training platforms. Pay rates are in USD and based on advertised hourly ranges.</p>

      <div class="jobs-grid" id="jobGrid">
        <!-- Job cards injected by JS -->
      </div>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="section" id="how" style="background:var(--surface); border-top:1px solid var(--border); border-bottom:1px solid var(--border);">
    <div class="container">
      <span class="eyebrow">Simple process</span>
      <h2 class="section-title">How it works</h2>
      <p class="section-sub">Three steps from application to your first paid task.</p>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Pick a role</h3>
          <p>Browse remote AI training jobs that match your background — from generalist data annotation to domain-expert evaluation.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Submit your details</h3>
          <p>Fill in your name, email, and phone number. We use this to match you with the right project team.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Pay the $15 fee &amp; get started</h3>
          <p>Your one-time $15 application fee activates your profile. Once verified, you can start applying to live tasks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== APPLY ========== -->
  <section class="section apply-section" id="apply">
    <div class="container apply-grid">
      <div class="apply-info">
        <span class="eyebrow">Get started</span>
        <h2>Apply once. Get matched with real work.</h2>
        <p>Your $15 lifetime application fee covers profile verification and matching. No subscriptions, no hidden charges. Pay once and you're in.</p>
        <div class="fee-box">
          <div class="fee-row"><span>Profile verification &amp; matching</span><span class="price">$15.00</span></div>
          <div class="fee-row"><span>Lifetime access</span><span class="price">Included</span></div>
          <div class="fee-row"><span>No recurring charges</span><span class="price">Included</span></div>
          <div class="fee-row total"><span>Total due today</span><span class="price">$15.00 USD</span></div>
        </div>
        <p class="fee-note">One-time payment. Secure checkout via Stripe. You will be redirected to Stripe's hosted checkout page to complete payment.</p>
      </div>

      <div class="form-card">
        <h3>Your application</h3>
        <p class="sub">Tell us who you are. All fields required.</p>
        <form id="applyForm" novalidate>
          <div class="field">
            <label for="fullName">Full name</label>
            <input type="text" id="fullName" name="fullName" placeholder="e.g. Alex Johnson" required autocomplete="name" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="phone">Phone number</label>
              <input type="tel" id="phone" name="phone" placeholder="+1 555 000 1234" required autocomplete="tel" />
            </div>
          </div>
          <div class="field">
            <label for="role">Role you're applying for</label>
            <select id="role" name="role" required>
              <option value="">Select a role…</option>
              <option>Generalist AI Data Annotator</option>
              <option>AI Response Reviewer / Rater</option>
              <option>Domain Expert — STEM / Math</option>
              <option>Coding &amp; Software Engineering Trainer</option>
              <option>Legal / Medical / Finance Evaluator</option>
              <option>Multilingual AI Quality Analyst</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-full" id="payBtn">
            Pay $15 &amp; submit application
          </button>
          <p class="form-disclaimer">By applying you agree to our terms. Your $15 fee is a one-time lifetime application fee.</p>
          <div class="form-msg" id="formMsg"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->
  <footer>
    <div class="container footer-inner">
      <p>&copy; 2026 AI Trainer Hub. All rights reserved.</p>
      <div class="footer-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <a href="#">Contact</a>
      </div>
    </div>
  </footer>

  <!-- ========== TOAST ========== -->
  <div class="toast" id="toast">Application submitted successfully!</div>

  <!-- ========== SCRIPTS ========== -->
  <script>
    /* =========================================================
       1. REALISTIC JOB DATA
       Based on advertised pay ranges from AI training platforms
       (Mercor, Outlier, Alignerr, OpenTrain AI, Invisible, etc.)
       ========================================================= */
    const jobs = [
      {
        role: 'Generalist AI Data Annotator',
        badge: 'Entry level',
        type: 'Part-time · Contract',
        location: 'Remote (Worldwide)',
        pay: '$15–$25',
        period: '/hr',
        desc: 'Label text, images, and short clips to help improve AI model accuracy. No prior experience required — training provided.'
      },
      {
        role: 'AI Response Reviewer / Rater',
        badge: 'Hot',
        type: 'Flexible hours',
        location: 'Remote (Global)',
        pay: '$20–$36',
        period: '/hr',
        desc: 'Review AI-generated answers for accuracy, safety, and reasoning quality. Provide structured written feedback to model developers.'
      },
      {
        role: 'Coding & Software Engineering Trainer',
        badge: 'Expert',
        type: 'Contract · 20+ hrs/wk',
        location: 'Remote (Worldwide)',
        pay: '$65',
        period: '/hr median',
        desc: 'Evaluate code solutions, write reference implementations, and rate AI coding outputs. Ideal for developers with 2+ years of experience.'
      },
      {
        role: 'Domain Expert — STEM / Math',
        badge: 'Expert',
        type: 'Contract · Flexible',
        location: 'Remote (Global)',
        pay: '$60–$120',
        period: '/hr',
        desc: 'Solve and grade advanced math and science problems used to train reasoning models. MSc or PhD preferred; strong undergraduates considered.'
      },
      {
        role: 'Legal / Medical / Finance Evaluator',
        badge: 'Premium',
        type: 'Part-time · Remote',
        location: 'Remote (Worldwide)',
        pay: '$40–$80',
        period: '/hr',
        desc: 'Apply professional domain knowledge to assess AI outputs in law, medicine, or finance. Licensed practitioners and graduate students welcome.'
      },
      {
        role: 'Multilingual AI Quality Analyst',
        badge: 'Language',
        type: 'Freelance · 10–30 hrs/wk',
        location: 'Remote (Global)',
        pay: '$25–$50',
        period: '/hr',
        desc: 'Review AI translations and multilingual outputs for fluency and cultural accuracy. Fluent in English plus one of: Spanish, French, German, Arabic, or Mandarin.'
      }
    ];

    /* Render job cards */
    const jobGrid = document.getElementById('jobGrid');
    jobGrid.innerHTML = jobs.map(job => `
      <article class="job-card">
        <div class="job-main">
          <div class="job-top">
            <span class="job-role">${job.role}</span>
            <span class="job-badge ${job.badge === 'Hot' ? 'hot' : ''}">${job.badge}</span>
          </div>
          <div class="job-meta">
            <span>📍 ${job.location}</span>
            <span>🕒 ${job.type}</span>
          </div>
          <p class="job-desc">${job.desc}</p>
        </div>
        <div class="job-side">
          <div class="job-pay">${job.pay} <small>${job.period}</small></div>
          <button class="btn-apply" onclick="scrollToApply()">Apply</button>
        </div>
      </article>
    `).join('');

    function scrollToApply() {
      document.getElementById('apply').scrollIntoView({ behavior: 'smooth' });
    }

    /* =========================================================
       2. FORM HANDLING + STRIPE CHECKOUT (DEMO MODE)
       ---------------------------------------------------------
       ⚠️ IMPORTANT: This is a front-end DEMO.
       In production you MUST create the Stripe Checkout Session
       on your server (backend) using your secret key.
       Never expose your Stripe secret key in front-end code.
       ========================================================= */

    const form = document.getElementById('applyForm');
    const formMsg = document.getElementById('formMsg');
    const payBtn = document.getElementById('payBtn');
    const toast = document.getElementById('toast');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formMsg.className = 'form-msg';
      formMsg.textContent = '';

      // --- Collect values ---
      const fullName = form.fullName.value.trim();
      const email = form.email.value.trim();
      const phone = form.phone.value.trim();
      const role = form.role.value;

      // --- Validation ---
      if (!fullName || !email || !phone || !role) {
        showMsg('Please fill in all fields before proceeding.', 'error');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showMsg('Please enter a valid email address.', 'error');
        return;
      }
      if (phone.replace(/\D/g, '').length < 7) {
        showMsg('Please enter a valid phone number.', 'error');
        return;
      }

      // --- Simulate server call to create Stripe Checkout Session ---
      payBtn.disabled = true;
      payBtn.textContent = 'Redirecting to secure checkout…';

      try {
        /*
         * ─────────────────────────────────────────────────────────
         * PRODUCTION FLOW (replace the simulation below):
         *
         * const res = await fetch('/api/create-checkout-session', {
         *   method: 'POST',
         *   headers: { 'Content-Type': 'application/json' },
         *   body: JSON.stringify({
         *     fullName, email, phone, role,
         *     amount: 1500,          // $15.00 in cents
         *     currency: 'usd'
         *   })
         * });
         * const data = await res.json();
         * window.location.href = data.url; // Stripe hosted checkout
         *
         * ─────────────────────────────────────────────────────────
         * DEMO SIMULATION (front-end only):
         */
        await new Promise(resolve => setTimeout(resolve, 1400));

        // In demo mode, we show success directly.
        // In production, the user would be on Stripe's checkout page now.
        showMsg(
          `✅ Thanks, ${fullName}! Your application for “${role}” has been received. ` +
          `You would now be redirected to Stripe to pay the $15 lifetime fee. ` +
          `(Demo mode — no real charge was made.)`,
          'success'
        );
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 4000);
        form.reset();
      } catch (err) {
        showMsg('Something went wrong. Please try again.', 'error');
        console.error(err);
      } finally {
        payBtn.disabled = false;
        payBtn.textContent = 'Pay $15 & submit application';
      }
    });

    function showMsg(text, type) {
      formMsg.textContent = text;
      formMsg.className = `form-msg ${type}`;
    }
  </script>
</body>
</html>
